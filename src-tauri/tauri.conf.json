{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Very Annoyed IP Scanner",
  "version": "0.2.0",
  "identifier": "com.shapedthought.veryannoyedipscanner",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Very Annoyed IP Scanner",
        "width": 1000,
        "height": 660,
        "minWidth": 720,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
